# 产物目录：每做一本书都落在这里，体积大、还含正文，不进版本库
work/

# Python 缓存
__pycache__/
*.pyc

# 本地日志
server.log

# 设计期的检查留痕（截图 + JSON），不属于运行项目
.taste-skill/

# 没有任何页面引用的素材索引
assets/credits.json

# Android 构建产物与本地配置：体积大、Gradle 可重建，不进版本库
android/.gradle/
android/.kotlin/
android/**/build/
android/.idea/
android/local.properties

# 发布签名凭据：含密钥库密码，绝不入库
android/keystore.properties
android/keystore/

# 分发包：APK 不进版本库，走 GitHub Release 挂附件
dist/
