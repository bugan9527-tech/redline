# 产物目录：每做一本书都落在这里，体积大、还含正文，不进版本库
work/

# Python 缓存
__pycache__/
*.pyc

# 本地日志
server.log

# 设计期的检查留痕（截图 + JSON），不属于运行项目
.taste-skill/

# 没有任何页面引用的素材索引
assets/credits.json

# Android 构建产物与本地配置：体积大、Gradle 可重建，不进版本库
android/.gradle/
android/**/build/
android/.idea/
android/local.properties

# 临时：引擎 requirement 的自带原生库（libomp / libopenblas / libc++_shared）。
# 它们是 Chaquopy 已经从 pypi 拉下来的二进制，不该进版本库——
# 接下去的壳侧 Gradle 任务会在构建时自动从 pip 产物拷进 lib/<abi>/。
android/app/src/main/jniLibs/
